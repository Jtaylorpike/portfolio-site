    "test:editor-contracts": "python -m unittest discover -s tests -p \"test_editor_*.py\""
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "typescript": "latest",
    "vite": "latest"
  },
  "dependencies": {
    "three": "^0.184.0"
  }
}
